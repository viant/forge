{
  "namespace": "example",
  "actions": {
    "code": "({initialize: ({state,windowForm}) => ({...state,scopeParams:{entityIds:(windowForm.prefill.entityIds||[]).map(Number),from:windowForm.prefill.from,to:windowForm.prefill.to},binding:{source:\"sampleRows\"},groupBy:\"category\",pageSize:50,orderField:\"day\",orderDir:\"asc\",viewMode:\"table\"}),build: ({state}) => ({filters:state.scopeParams,measures:{amount:true,count:true},dimensions:{day:true,category:true},limit:50,offset:0})})"
  },
  "config": {
    "title": "Synthetic records",
    "dataSourceRef": "sampleRows",
    "hooks": {
      "initializeState": "initialize",
      "buildRequest": "build"
    },
    "measures": [
      {
        "id": "amount",
        "key": "amount",
        "paramPath": "measures.amount",
        "default": true
      },
      {
        "id": "count",
        "key": "count",
        "paramPath": "measures.count",
        "default": true
      }
    ],
    "dimensions": [
      {
        "id": "day",
        "key": "day",
        "paramPath": "dimensions.day",
        "default": true
      },
      {
        "id": "category",
        "key": "category",
        "paramPath": "dimensions.category",
        "default": true
      }
    ],
    "predicates": [
      {
        "id": "entityIds",
        "bucket": "scope",
        "multiple": true,
        "emitArray": true,
        "manualEntry": true,
        "manualValueType": "int",
        "paramPath": "filters.entityIds",
        "prefill": {
          "selector": "prefill.entityIds"
        }
      },
      {
        "id": "range",
        "kind": "dateRange",
        "startParamPath": "filters.from",
        "endParamPath": "filters.to",
        "prefill": {
          "startSelector": "prefill.from",
          "endSelector": "prefill.to"
        }
      }
    ],
    "result": {
      "defaultMode": "table",
      "pageSize": 50,
      "chartLimit": 1000,
      "chartDataMode": "fullQuery",
      "chartRowLimit": 1000
    },
    "dataSources": [
      {
        "id": "summary",
        "dataSourceRef": "sampleRows",
        "request": {
          "measures": {
            "amount": true
          }
        },
        "scope": {
          "mode": "inherit"
        },
        "capabilities": {
          "backendRefetch": true
        }
      }
    ]
  },
  "windowForm": {
    "prefill": {
      "entityIds": [
        7
      ],
      "from": "2026-01-01",
      "to": "2026-01-02"
    },
    "reportBuilderRef": "sampleBuilder"
  },
  "request": {
    "filters": {
      "entityIds": [
        7
      ],
      "from": "2026-01-01",
      "to": "2026-01-02"
    },
    "measures": {
      "amount": true,
      "count": true
    },
    "dimensions": {
      "day": true,
      "category": true
    },
    "limit": 50,
    "offset": 0
  },
  "published": [
    {
      "request": {
        "measures": {
          "amount": true
        },
        "filters": {
          "entityIds": [
            7
          ],
          "from": "2026-01-01",
          "to": "2026-01-02"
        }
      }
    }
  ]
}
