{
  "functions": [
    {
      "name": "deltaFromPrevious",
      "label": "Delta From Previous",
      "supportsPartition": true,
      "requiresOrder": true,
      "nullBehavior": "nonFiniteValuesYieldZeroAndDoNotAdvancePreviousFiniteValue",
      "defaultFormat": "number"
    },
    {
      "name": "lag",
      "label": "Lag",
      "supportsPartition": true,
      "requiresOrder": true,
      "supportsOffset": true,
      "nullBehavior": "missingOrNullPriorRowYieldsNullWithoutSkippingRows",
      "defaultFormat": "number"
    },
    {
      "name": "movingAverage",
      "label": "Moving Average",
      "supportsPartition": true,
      "requiresOrder": true,
      "requiresWindowSize": true,
      "supportsDecimals": true,
      "nullBehavior": "windowAveragesIgnoreNonFiniteValues",
      "defaultFormat": "number"
    },
    {
      "name": "percentOfTotal",
      "label": "Percent of Total",
      "supportsPartition": true,
      "supportsDecimals": true,
      "usesFilteredScopeTotal": true,
      "nullBehavior": "nonFiniteValuesYieldZeroAndAreExcludedFromTotals",
      "defaultFormat": "percent"
    },
    {
      "name": "rank",
      "label": "Rank",
      "supportsPartition": true,
      "requiresOrder": true,
      "supportsRankDirection": true,
      "supportsTieBreaker": true,
      "tieMode": "dense",
      "nullBehavior": "nonFiniteValuesYieldNullAndDoNotAdvanceRank",
      "defaultFormat": "number"
    },
    {
      "name": "runningTotal",
      "label": "Running Total",
      "supportsPartition": true,
      "requiresOrder": true,
      "nullBehavior": "nonFiniteValuesDoNotAdvanceRunningTotal",
      "defaultFormat": "number"
    },
    {
      "name": "windowMax",
      "label": "Window Maximum",
      "supportsPartition": true,
      "requiresExplicitFrame": true,
      "boundedFrameRequiresOrder": true,
      "nullBehavior": "ignoresNonFiniteValuesAndReturnsNullForAnEmptyNumericWindow",
      "defaultFormat": "number"
    }
  ],
  "runtimeCases": [
    {
      "id": "percent_of_total_global",
      "definitions": [
        {
          "id": "spendShare",
          "key": "spendShare",
          "label": "Spend Share",
          "dataType": "number",
          "compute": {
            "type": "percentOfTotal",
            "sourceField": "spend",
            "scale": 100,
            "decimals": 1
          }
        }
      ],
      "rows": [
        { "channel": "Display", "spend": 40 },
        { "channel": "CTV", "spend": 60 }
      ],
      "expectedRows": [
        { "channel": "Display", "spend": 40, "spendShare": 40 },
        { "channel": "CTV", "spend": 60, "spendShare": 60 }
      ]
    },
    {
      "id": "percent_of_total_partitioned",
      "definitions": [
        {
          "id": "spendShareByChannel",
          "key": "spendShareByChannel",
          "label": "Spend Share By Channel",
          "dataType": "number",
          "compute": {
            "type": "percentOfTotal",
            "sourceField": "spend",
            "partitionBy": ["channel"],
            "scale": 100,
            "decimals": 0
          }
        }
      ],
      "rows": [
        { "channel": "Display", "market": "US", "spend": 40 },
        { "channel": "Display", "market": "CA", "spend": 60 },
        { "channel": "CTV", "market": "US", "spend": 10 },
        { "channel": "CTV", "market": "CA", "spend": 30 }
      ],
      "expectedRows": [
        { "channel": "Display", "market": "US", "spend": 40, "spendShareByChannel": 40 },
        { "channel": "Display", "market": "CA", "spend": 60, "spendShareByChannel": 60 },
        { "channel": "CTV", "market": "US", "spend": 10, "spendShareByChannel": 25 },
        { "channel": "CTV", "market": "CA", "spend": 30, "spendShareByChannel": 75 }
      ]
    },
    {
      "id": "running_total_partitioned",
      "definitions": [
        {
          "id": "runningSpend",
          "key": "runningSpend",
          "label": "Running Spend",
          "dataType": "number",
          "compute": {
            "type": "runningTotal",
            "sourceField": "spend",
            "partitionBy": ["channel"],
            "orderBy": [
              { "field": "eventDate", "direction": "asc" }
            ]
          }
        }
      ],
      "rows": [
        { "eventDate": "2026-05-02", "channel": "Display", "spend": 20 },
        { "eventDate": "2026-05-01", "channel": "Display", "spend": 10 },
        { "eventDate": "2026-05-01", "channel": "CTV", "spend": 5 },
        { "eventDate": "2026-05-02", "channel": "CTV", "spend": 15 }
      ],
      "expectedRows": [
        { "eventDate": "2026-05-02", "channel": "Display", "spend": 20, "runningSpend": 30 },
        { "eventDate": "2026-05-01", "channel": "Display", "spend": 10, "runningSpend": 10 },
        { "eventDate": "2026-05-01", "channel": "CTV", "spend": 5, "runningSpend": 5 },
        { "eventDate": "2026-05-02", "channel": "CTV", "spend": 15, "runningSpend": 20 }
      ]
    },
    {
      "id": "delta_from_previous_null_handling",
      "definitions": [
        {
          "id": "deltaSpend",
          "key": "deltaSpend",
          "label": "Delta Spend",
          "dataType": "number",
          "compute": {
            "type": "deltaFromPrevious",
            "sourceField": "spend",
            "orderBy": [
              { "field": "eventDate", "direction": "asc" }
            ]
          }
        }
      ],
      "rows": [
        { "eventDate": "2026-05-01", "spend": 10 },
        { "eventDate": "2026-05-02", "spend": null },
        { "eventDate": "2026-05-03", "spend": 15 }
      ],
      "expectedRows": [
        { "eventDate": "2026-05-01", "spend": 10, "deltaSpend": 0 },
        { "eventDate": "2026-05-02", "spend": null, "deltaSpend": 0 },
        { "eventDate": "2026-05-03", "spend": 15, "deltaSpend": 5 }
      ]
    },
    {
      "id": "moving_average_window_ignores_non_finite_values",
      "definitions": [
        {
          "id": "movingSpend",
          "key": "movingSpend",
          "label": "Moving Spend",
          "dataType": "number",
          "compute": {
            "type": "movingAverage",
            "sourceField": "spend",
            "orderBy": [
              { "field": "eventDate", "direction": "asc" }
            ],
            "windowSize": 2,
            "decimals": 1
          }
        }
      ],
      "rows": [
        { "eventDate": "2026-05-01", "spend": 10 },
        { "eventDate": "2026-05-02", "spend": null },
        { "eventDate": "2026-05-03", "spend": 30 }
      ],
      "expectedRows": [
        { "eventDate": "2026-05-01", "spend": 10, "movingSpend": 10 },
        { "eventDate": "2026-05-02", "spend": null, "movingSpend": 10 },
        { "eventDate": "2026-05-03", "spend": 30, "movingSpend": 30 }
      ]
    },
    {
      "id": "dense_rank_with_ties_and_null",
      "definitions": [
        {
          "id": "rankSpend",
          "key": "rankSpend",
          "label": "Rank Spend",
          "dataType": "number",
          "compute": {
            "type": "rank",
            "sourceField": "spend",
            "orderBy": [
              { "field": "spend", "direction": "desc" },
              { "field": "eventDate", "direction": "asc" }
            ],
            "tieMode": "dense"
          }
        }
      ],
      "rows": [
        { "eventDate": "2026-05-01", "spend": 100 },
        { "eventDate": "2026-05-02", "spend": 100 },
        { "eventDate": "2026-05-03", "spend": 50 },
        { "eventDate": "2026-05-04", "spend": null }
      ],
      "expectedRows": [
        { "eventDate": "2026-05-01", "spend": 100, "rankSpend": 1 },
        { "eventDate": "2026-05-02", "spend": 100, "rankSpend": 1 },
        { "eventDate": "2026-05-03", "spend": 50, "rankSpend": 2 },
        { "eventDate": "2026-05-04", "spend": null, "rankSpend": null }
      ]
    },
    {
      "id": "mixed_dependency_order",
      "definitions": [
        {
          "id": "score",
          "expr": "if(isnull(previous), value / peak, 1 + (normalized - previous) / abs(previous))"
        },
        {
          "id": "previous",
          "compute": {
            "type": "lag",
            "sourceField": "normalized",
            "orderBy": [
              {
                "field": "value",
                "direction": "desc"
              }
            ]
          }
        },
        {
          "id": "peak",
          "compute": {
            "type": "windowMax",
            "sourceField": "capacity",
            "frame": {
              "type": "full"
            }
          }
        },
        {
          "id": "normalized",
          "expr": "coalesce(value, 0)"
        }
      ],
      "rows": [
        {
          "label": "a",
          "value": 8,
          "capacity": 100
        },
        {
          "label": "b",
          "value": 32,
          "capacity": 200
        },
        {
          "label": "c",
          "value": 16,
          "capacity": 180
        }
      ],
      "expectedRows": [
        {
          "label": "a",
          "value": 8,
          "capacity": 100,
          "normalized": 8,
          "previous": 16,
          "peak": 200,
          "score": 0.5
        },
        {
          "label": "b",
          "value": 32,
          "capacity": 200,
          "normalized": 32,
          "previous": null,
          "peak": 200,
          "score": 0.16
        },
        {
          "label": "c",
          "value": 16,
          "capacity": 180,
          "normalized": 16,
          "previous": 32,
          "peak": 200,
          "score": 0.5
        }
      ]
    },
    {
      "id": "lag_preserves_null_and_zero_positions",
      "definitions": [
        {
          "id": "previous",
          "compute": {
            "type": "lag",
            "sourceField": "value",
            "orderBy": [
              {
                "field": "index",
                "direction": "asc"
              }
            ]
          }
        }
      ],
      "rows": [
        {
          "index": 1,
          "value": 2
        },
        {
          "index": 2,
          "value": null
        },
        {
          "index": 3,
          "value": 0
        },
        {
          "index": 4,
          "value": -1
        }
      ],
      "expectedRows": [
        {
          "index": 1,
          "value": 2,
          "previous": null
        },
        {
          "index": 2,
          "value": null,
          "previous": 2
        },
        {
          "index": 3,
          "value": 0,
          "previous": null
        },
        {
          "index": 4,
          "value": -1,
          "previous": 0
        }
      ]
    },
    {
      "id": "window_max_partition_and_bounded_frame",
      "definitions": [
        {
          "id": "peak",
          "compute": {
            "type": "windowMax",
            "sourceField": "value",
            "partitionBy": [
              "group"
            ],
            "frame": {
              "type": "full"
            }
          }
        },
        {
          "id": "nearby",
          "compute": {
            "type": "windowMax",
            "sourceField": "value",
            "partitionBy": [
              "group"
            ],
            "orderBy": [
              {
                "field": "index",
                "direction": "asc"
              }
            ],
            "frame": {
              "type": "rows",
              "preceding": 1,
              "following": 0
            }
          }
        }
      ],
      "rows": [
        {
          "group": "a",
          "index": 1,
          "value": 5
        },
        {
          "group": "a",
          "index": 2,
          "value": null
        },
        {
          "group": "a",
          "index": 3,
          "value": -2
        },
        {
          "group": "b",
          "index": 1,
          "value": null
        }
      ],
      "expectedRows": [
        {
          "group": "a",
          "index": 1,
          "value": 5,
          "peak": 5,
          "nearby": 5
        },
        {
          "group": "a",
          "index": 2,
          "value": null,
          "peak": 5,
          "nearby": 5
        },
        {
          "group": "a",
          "index": 3,
          "value": -2,
          "peak": 5,
          "nearby": -2
        },
        {
          "group": "b",
          "index": 1,
          "value": null,
          "peak": null,
          "nearby": null
        }
      ]
    },
    {
      "id": "lag_explicit_tie_break_and_partition",
      "definitions": [
        {
          "id": "previous",
          "dataType": "string",
          "compute": {
            "type": "lag",
            "sourceField": "label",
            "partitionBy": [
              "group"
            ],
            "orderBy": [
              {
                "field": "score",
                "direction": "desc"
              },
              {
                "field": "label",
                "direction": "asc"
              }
            ]
          }
        }
      ],
      "rows": [
        {
          "group": "a",
          "label": "b",
          "score": 5
        },
        {
          "group": "a",
          "label": "a",
          "score": 5
        },
        {
          "group": "b",
          "label": "c",
          "score": 1
        }
      ],
      "expectedRows": [
        {
          "group": "a",
          "label": "b",
          "score": 5,
          "previous": "a"
        },
        {
          "group": "a",
          "label": "a",
          "score": 5,
          "previous": null
        },
        {
          "group": "b",
          "label": "c",
          "score": 1,
          "previous": null
        }
      ]
    }
  ]
}
